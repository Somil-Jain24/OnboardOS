{
  "name": "onboardos-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "OnboardOS - AI-Assisted Employee Onboarding Orchestration Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=prisma/schema.prisma"
  },
  "keywords": [
    "onboardos",
    "onboarding",
    "orchestration",
    "rbac",
    "ai-orchestrator"
  ],
  "author": "OnboardOS Team",
  "license": "MIT"
}
